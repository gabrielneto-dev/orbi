# Variáveis de ambiente do orbi. Copie para .env e preencha os valores.
# Este arquivo só lista NOMES: nunca coloque valores reais aqui. O .env é ignorado pelo git.
# Em produção, os valores vêm do ambiente da VPS (fora do repositório).

# --- Banco de dados (PostgreSQL) ---
# Senha do superusuário do contêiner local (docker/compose.dev.yml). Só desenvolvimento.
POSTGRES_PASSWORD=
# Porta local do PostgreSQL do Docker (padrão 5433).
POSTGRES_PORT=
# Superusuário, usado só por `pnpm db:bootstrap` (cria papéis e base) e pelos testes de integração.
# Nunca use na aplicação. Ex. local: postgres://postgres:<POSTGRES_PASSWORD>@localhost:5433/postgres
DATABASE_URL_ADMIN=
# Conexão da aplicação: papel orbi_app, sem BYPASSRLS (criado na T005).
DATABASE_URL=
# Conexão das migrações: papel orbi_owner (T005).
DATABASE_URL_OWNER=
# Conexão da plataforma: papel orbi_platform (T005).
DATABASE_URL_PLATFORM=
# Conexão do módulo de autenticação (Better Auth): papel orbi_auth (T008). Só src/server/auth usa.
DATABASE_URL_AUTH=

# --- Autenticação (Better Auth) ---
# Segredo de assinatura (mín. 32 caracteres aleatórios). Ex.: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública da aplicação. Local: http://localhost:3000. Em produção, https:// (cookies Secure).
BETTER_AUTH_URL=
# Minutos sem uso até a sessão expirar (REQ-049). Opcional; padrão 480 (8 horas).
SESSION_IDLE_TIMEOUT_MINUTES=

# --- Arquivos (S3; MinIO no desenvolvimento) ---
# No desenvolvimento: S3_ENDPOINT=http://localhost:9000 e as chaves são as credenciais do MinIO local.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Portas locais do MinIO (padrão 9000 para a API e 9001 para o console web).
MINIO_API_PORT=
MINIO_CONSOLE_PORT=

# --- Backup (produção) ---
BACKUP_S3_BUCKET=

# --- Observabilidade (opcional) ---
SENTRY_DSN=
